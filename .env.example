# ── NeuralNav server configuration ─────────────────────────────────
# Copy to .env and export, or set inline: `PORT=4173 cargo run -p neuralnav-server`
# Everything works with the defaults below — no keys required.

RUST_LOG=info
PORT=4173

# ── Real adapters (all optional; default = mock) ───────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
USE_REAL_PLANNER=false
USE_REAL_BROWSER=false
USE_REAL_ASR=false
USE_REAL_TTS=false

# ── Browser runtime ────────────────────────────────────────────────
HEADLESS=true
ADBLOCK_ENABLED=true
# name=url pairs or bare urls, comma separated: edge=http://p1:8080,http://p2:8080
DEFAULT_PROXY=
PLAYWRIGHT_WORKER_DIR=workers/playwright-worker

# ── Guardrails ─────────────────────────────────────────────────────
# read_only | interactive | restricted
PERMISSION_LEVEL=interactive

# ── Static frontend (serves web/dist when it exists) ───────────────
STATIC_DIR=
